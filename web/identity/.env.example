# Identity (hosted login) SPA — runtime configuration.
#
# OPTIONAL. In the release image the identity app is served same-origin by the Go
# binary and this is injected at runtime via /config.js (window.__ENV__), so no
# rebuild is needed to retarget the API. When unset, config.ts falls back to the
# same-origin /api/v1 path. Set only for a split-host dev/deploy; the hostname
# must match the real nginx alias (identity-api = data plane :8081).
VITE_AUTH_API_BASE_URL=https://identity-api.auth.maintainerd.local/api/v1
