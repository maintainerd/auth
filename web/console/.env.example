# Console SPA — runtime configuration.
#
# ALL VALUES ARE OPTIONAL. In the release image the console is served same-origin
# by the Go binary and these are injected at runtime via /config.js (window.__ENV__),
# so you do NOT rebuild to retarget the API. When unset, config.ts falls back to
# same-origin paths (/api/v1 and /public-api/api/v1). Set them only for a
# split-host dev/deploy (e.g. the maintainerd-dev nginx topology below).
#
# Hostnames must match nginx aliases that actually exist:
#   console-api  = control plane (:8080)   identity-api = data plane (:8081)

# Control plane (management API).
VITE_AUTH_API_BASE_URL=https://console-api.auth.maintainerd.local/api/v1
# Data plane (OAuth2/OIDC + tenant bootstrap; token exchange runs here).
VITE_AUTH_PUBLIC_API_BASE_URL=https://identity-api.auth.maintainerd.local/api/v1
# Last-resort identity origin; the real one is per-tenant from the bootstrap
# response (identity_url) and only used when that is unavailable.
VITE_AUTH_IDENTITY_BASE_URL=https://identity.auth.maintainerd.local
