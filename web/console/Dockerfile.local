# Local development Dockerfile for React + Vite app
# Optimized for development with hot reload

FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32

# Set working directory
WORKDIR /app

# Install curl for health checks
RUN apk add --no-cache curl

# Copy package files first for better caching
COPY package*.json ./

# Install exactly what the lockfile pins (dev deps included; NODE_ENV=development)
# THE RETRY SETTINGS AND THE CACHE MOUNT ARE BOTH LOAD-BEARING on a laptop. The
# dev stack builds four SPAs and four Go binaries concurrently, so four `npm ci`
# runs compete for one connection and npm's 5-minute default read timeout expires
# — `npm error network read ETIMEDOUT`, which fails the whole `up`.
#
#   --fetch-retries 5        npm's default of 2 gives up too early under contention
#   --fetch-retry-maxtimeout capped backoff, so a slow mirror is waited out
#   --fetch-timeout          raised from 5m; a saturated link is slow, not broken
#
# The BuildKit cache mount is what makes a retry cheap: packages already fetched
# survive the failed layer, so the second attempt resumes instead of restarting a
# ~200MB download from zero.
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm ci \
      --fetch-retries=5 \
      --fetch-retry-mintimeout=20000 \
      --fetch-retry-maxtimeout=120000 \
      --fetch-timeout=600000

# Copy source code
COPY . .

# Expose Vite dev server port
EXPOSE 3000

# Health check for development server
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

# Start development server with host binding for Docker
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
