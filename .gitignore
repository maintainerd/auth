coverage.*
*.coverprofile
*.cov
*.testresult

# Graphify backup snapshots (auto-generated by graphify update)
graphify-out/20*/

# Logs
*.log
*.tmp
debug/

# Node-related (if using frontend in same repo)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
*.bak
*.old
*.orig

# AI tools (local only)
.agents/
.claude/
.codex/
.opencode/
AGENTS.md
CLAUDE.md
graphify-out/

# Air live reload temp
.air.toml
tmp/
# Anchored to the repo root: this is the compiled binary Air builds. Unanchored,
# it also matched internal/server/, silently ignoring real source files there.
/server

# SPA dist embedded into the release binary at Docker build time (go:embed under
# -tags embedassets). Populated only inside the image build — never committed.
/internal/webui/console/
/internal/webui/identity/
