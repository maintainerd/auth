# =============================================================================
# maintainerd-auth — Environment Template
# Copy to .env and fill in your values.
# =============================================================================

APP_ENV=development
APP_VERSION=0.1.0

APP_PUBLIC_HOSTNAME=https://public-api.auth.maintainerd.local
APP_PRIVATE_HOSTNAME=https://private-api.auth.maintainerd.local

# ---- Database ------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=maintainerd
DB_PASSWORD=<your-db-password>
DB_NAME=maintainerd
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SEC=300
DB_STATEMENT_TIMEOUT_MS=30000

# ---- Redis ---------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=<your-redis-password>
REDIS_TLS=false

# ---- JWT & Encryption ----------------
# Generate with: ./scripts/generate-jwt-keys.sh
JWT_PRIVATE_KEY=<generate>
JWT_PUBLIC_KEY=<generate>
JWT_KEY_ROTATION_PERIOD_SECONDS=86400
APP_ENCRYPTION_KEY=<generate with: openssl rand -base64 32>
HMAC_SECRET_KEY=<generate with: openssl rand -base64 32>

# ---- Cookies -------------------------
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- Logging -------------------------
LOG_LEVEL=info
