# =============================================================================
#  maintainerd-auth — SAMPLE environment (examples/quickstart)
#
#  SAMPLE ONLY. Placeholder, non-secret values — safe to commit and share.
#  There are NO real credentials here.
#
#  Usage:  cp .env.example .env  &&  ./setup.sh  &&  docker compose up -d
#  Never commit your filled-in `.env`.
# =============================================================================

APP_ENV=development

# --- Hostnames (served by nginx over HTTPS, no ports) -----------------------
APP_FRONTEND_CONSOLE_HOSTNAME=https://console.auth.maintainerd.local
APP_FRONTEND_IDENTITY_HOSTNAME=https://identity.auth.maintainerd.local
APP_PUBLIC_HOSTNAME=https://identity-api.auth.maintainerd.local     # OIDC issuer + public API
APP_PRIVATE_HOSTNAME=https://console-api.auth.maintainerd.local     # control plane (internal)

# nginx terminates TLS, so cookies are served over HTTPS.
COOKIE_SECURE=true
# Trust the single nginx hop for X-Forwarded-* (local only).
TRUST_ALL_PROXIES=true

# WebAuthn / passkeys. RP ID must be a registrable parent of every surface
# (console, identity, APIs); list each browser origin that enrolls a passkey.
# Without these, passkey enrollment fails with
# "'rp.id' cannot be used with the current origin".
WEBAUTHN_RP_ID=auth.maintainerd.local
WEBAUTHN_EXTRA_ORIGINS=https://console.auth.maintainerd.local,https://identity.auth.maintainerd.local

# --- PostgreSQL (matches the docker-compose service names) -------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=maintainerd
DB_PASSWORD=change-me
DB_NAME=maintainerd
DB_SSLMODE=disable

# --- Redis ------------------------------------------------------------------
REDIS_ADDR=redis:6379

# --- Secrets ----------------------------------------------------------------
# Do NOT hand-write these. `./setup.sh` generates a fresh RSA JWT keypair +
# a 32-byte encryption key + an HMAC key locally (openssl) and appends them here.
