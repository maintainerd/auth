# =============================================================================
#  maintainerd-auth — SAMPLE environment (examples/quickstart)
#
#  SAMPLE ONLY. Placeholder, non-secret values — safe to commit and share.
#  There are NO real credentials in this file.
#
#  Usage:
#    1) cp .env.example .env
#    2) ./generate-secrets.sh          # appends YOUR own keys/secrets to .env
#    3) docker compose up -d
#
#  Never commit your filled-in `.env`.
# =============================================================================

APP_ENV=development

# --- Hostnames --------------------------------------------------------------
# The single container serves each surface on its own port. Map these names to
# 127.0.0.1 in /etc/hosts (see README) so your browser can reach them.
APP_FRONTEND_CONSOLE_HOSTNAME=http://console.auth.maintainerd.local:3000
APP_FRONTEND_IDENTITY_HOSTNAME=http://identity.auth.maintainerd.local:3001
APP_PUBLIC_HOSTNAME=http://identity-api.auth.maintainerd.local:8081   # OIDC issuer + public API
APP_PRIVATE_HOSTNAME=http://console-api.auth.maintainerd.local:8080   # control plane (internal)

# http on .local is for LOCAL TRIALS ONLY. In production use real HTTPS hosts
# and set COOKIE_SECURE=true.
COOKIE_SECURE=false

# --- PostgreSQL (matches the docker-compose service names) -------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=maintainerd
DB_PASSWORD=change-me
DB_NAME=maintainerd
DB_SSLMODE=disable

# --- Redis ------------------------------------------------------------------
REDIS_ADDR=redis:6379

# --- Secrets ----------------------------------------------------------------
# Do NOT hand-write these. `./generate-secrets.sh` generates a fresh RSA JWT
# keypair + a 32-byte encryption key + an HMAC key locally (openssl) and appends
# them below. Values accept a `base64:` prefix. For reference only:
#   APP_ENCRYPTION_KEY=base64:<32 random bytes, base64>
#   HMAC_SECRET_KEY=base64:<random bytes, base64>
#   JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
#   JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
