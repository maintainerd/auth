{
  "content": {
    "items": [
      {
        "description": "Container or dev CLI as the project prescribes — never ad-hoc on the host; parity is the point.",
        "enforcement": "strict",
        "id": "3600efd2-70d7-40cd-b5ad-8ad70bb07c3c",
        "status": "verified",
        "text": "Run builds/tests in the project's sanctioned runtime"
      },
      {
        "description": "--force, rm -rf outside the workspace, reset --hard, checkout '.' — irreversible actions need a human.",
        "enforcement": "strict",
        "id": "84ba2dca-a6e3-410a-9051-e001094a46d8",
        "status": "verified",
        "text": "No destructive or history-rewriting commands"
      },
      {
        "description": "Never by output presence — passing logs lie. Check the code, count the assertions.",
        "enforcement": "strict",
        "id": "90049d06-3f76-4bcc-bcca-08d2d9de2089",
        "status": "verified",
        "text": "Judge success by exit code and expected assertions"
      },
      {
        "description": "Lockfile changes and new packages are supply-chain decisions for a human.",
        "enforcement": "strict",
        "id": "f1a60d67-4c6e-4c34-9eda-5fef8e053c86",
        "status": "verified",
        "text": "No dependency installs or version bumps without approval"
      },
      {
        "description": "Never read, echo or commit .env/secret material; no credentials inline in commands.",
        "enforcement": "strict",
        "id": "a5d6ca74-9296-4cda-bbc0-70b5a2976eb7",
        "status": "verified",
        "text": "Secrets stay untouched"
      },
      {
        "description": "A green run before your final change proves nothing about the final state.",
        "enforcement": "strict",
        "id": "fec03ba7-3261-4262-9648-8ce683b0bfe7",
        "status": "verified",
        "text": "Re-run the gate after the LAST edit"
      }
    ],
    "kind": "checklist"
  },
  "createdAt": "2026-07-21T14:32:38.711Z",
  "description": "How agents run builds, tests and commands during implementation and verification — operational safety and honest gates.",
  "id": "197d289c-06cc-4cd5-b560-2efd427ed161",
  "name": "Command discipline",
  "status": "verified",
  "tags": [
    "system"
  ],
  "type": "rule",
