{
  "content": {
    "items": [
      {
        "description": "Derive it from the code — comments, validations, call sites. Never leave it empty and never write filler.",
        "enforcement": "strict",
        "id": "ca29931b-ce54-484e-bbc4-78cf08830622",
        "status": "verified",
        "text": "Every field carries a description: what it is used for"
      },
      {
        "description": "implemented = exists in code · verified = behavior proven · planned = not built yet. Extraction from real code marks fields implemented explicitly.",
        "enforcement": "strict",
        "id": "301cad15-fdfb-405e-a7ce-f58ac52d49cf",
        "status": "verified",
        "text": "Every field carries a truthful status"
      },
      {
        "description": "The app displays this inverted as a Nullable checkbox. Record real nullability and real defaults (the `default` key, verbatim from code/schema).",
        "enforcement": "strict",
        "id": "80240c05-c661-4c30-9fd3-e99b41dca1cc",
        "status": "verified",
        "text": "On a DB model, required: true means NOT NULL"
      },
      {
        "description": "update replaces `content` whole, BUT units matched by id (or name when the patch has no id) keep their existing id, status and description when the patch omits them. Explicit values always win. Still set what you know.",
        "enforcement": "strict",
        "id": "a111153f-9e39-4f65-bf0a-26a209d3b0ee",
        "status": "verified",
        "text": "Content rewrites preserve unit state"
      }
    ],
    "kind": "checklist"
  },
  "createdAt": "2026-07-21T14:32:38.678Z",
  "description": "Applies to ALL fields content — models and structures alike: the CLI REJECTS any field lacking a description or a status. The DB-specific items below (NOT NULL, DDL defaults, FKs) bind MODELS only — structures carry code types and no DB semantics.",
