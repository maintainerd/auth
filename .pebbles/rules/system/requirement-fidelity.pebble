{
  "content": {
    "items": [
      {
        "description": "Copy them into the plan verbatim; every implementation step maps to a criterion. Unmapped steps are scope invention — forbidden.",
        "enforcement": "strict",
        "id": "c6bbc176-6f36-4f65-a225-b0aefe7bdfb5",
        "status": "verified",
        "text": "Acceptance criteria ARE the checklist"
      },
      {
        "description": "Adding, narrowing or \"improving\" a requirement requires a recorded finding, never an inline decision.",
        "enforcement": "strict",
        "id": "0f35fba4-b2c0-4282-9916-2b94e2d85177",
        "status": "verified",
        "text": "No silent scope changes"
      },
      {
        "description": "Ask when interactive; otherwise record an assumption finding stating the interpretation chosen and why. Silent interpretation is a defect.",
        "enforcement": "strict",
        "id": "b1ae2099-7e29-45d7-ab74-03cfa893e453",
        "status": "verified",
        "text": "Ambiguity halts or records"
      },
      {
        "description": "State which dependent pebbles/behaviors were checked for unchanged behavior — \"I only touched X\" requires showing X's dependents.",
        "enforcement": "strict",
        "id": "8bfb0819-ac9e-4b5a-9c9e-b84690bade89",
        "status": "verified",
        "text": "Prove non-regression"
      },
      {
        "description": "Re-read the original ask LAST, diff it against what was built, and report mismatches.",
        "enforcement": "strict",
        "id": "ce44e706-d6db-48f2-8919-94b8131a53f3",
        "status": "verified",
        "text": "Fidelity diff before claiming done"
      }
    ],
    "kind": "checklist"
  },
  "createdAt": "2026-07-21T14:32:38.715Z",
  "description": "The built thing matches the asked thing: acceptance criteria are the checklist, ambiguity is recorded, scope is never silently changed.",
  "id": "4e4afae6-8bf7-4310-b541-a26b7e3bd37d",
  "name": "Requirement fidelity",
