{
  "content": {
    "arguments": "$ARGUMENTS",
    "constraints": [
      {
        "id": "b0bb6a1e-9170-4acb-9f5c-85f22c46d2fb",
        "text": "Use the Bash tool. The Pebbles CLI at \"{PEBBLES_CLI}\" is the ONLY sanctioned way to change spec files — never edit .pebble files directly."
      },
      {
        "id": "ecd65a3e-6ecb-4e5f-9012-4d42b0f775de",
        "text": "Bound by system rule: Spec mutation contract (rules/system/spec-mutation-contract)"
      },
      {
        "id": "0bce3c7d-85cb-4c17-8de6-97428a32c746",
        "text": "Bound by system rule: Reference integrity (rules/system/reference-integrity)"
      },
      {
        "id": "c65dc26b-6005-49b3-945d-271c01423f88",
        "text": "Bound by system rule: Graph-first navigation (rules/system/graph-first-navigation)"
      }
    ],
    "examples": [],
    "kind": "skill",
    "onFailure": [
      {
        "id": "02d006da-0583-4394-974e-74a5dbb06b55",
        "text": "Read the CLI error — it names the fix; correct the call and retry once"
      },
      {
        "id": "f578e70d-d9db-458f-a7f5-d3b7a13ab683",
        "text": "NEVER fall back to editing .pebble files directly, whatever failed"
      },
      {
        "id": "3d5fbd69-eb58-4d0f-a3a5-2bd90315f87d",
        "text": "If still blocked, report the exact command and error to the user and stop"
      }
    ],
    "output": "codeLinks on the pebble; each link's path doubles as a map node id.",
    "prerequisites": [
      {
        "id": "8647ea9b-538b-4592-b504-319c0a72aace",
        "text": "A saved map — find implementing files via the graph, not grep"
      }
    ],
    "purpose": "Bind a pebble to its implementation files",
    "steps": [
      {
        "id": "ea4c7820-1c0d-4bac-8b85-a609879dee86",
        "text": "Bind a pebble to every file that implements it: $ARGUMENTS"
      },
      {
        "id": "72c4335f-252d-4436-9fb4-15d94195fd1d",
        "text": "STEP 1 — READ the pebble (`get`) so you know exactly what implementation you are hunting for."
      },
      {
        "id": "5939a446-01b9-450d-be2c-4311d748efdf",
        "text": "STEP 2 — FIND ALL of it via the graph (map-symbol/map-search/map-neighbors) — a feature usually spans SEVERAL files; linking only some leaves the spec half-bound. Use the map, do not grep."
      },
      {
        "id": "f2a26c6b-75ce-49bc-b257-21574d124a11",
        "text": "STEP 3 — LINK each: \"{PEBBLES_CLI}\" link-code <pebble> --file <rel-path> [--symbol NAME] [--line N] [--note \"why\"]. link-code refuses files that do not exist (a refusal means your path is wrong, not that the code is missing)."
      },
      {
        "id": "1e355ef8-e800-40c1-abc0-b17f2444bb4b",
        "text": "Report: the links made (refs <pebble> confirms them); a codeLink's path doubles as a map node id for instant map-file analysis later."
      }
    ],
    "verify": [
      {
        "id": "2b2ff762-eb55-43ef-be7c-05dc26f3446e",
        "text": "Every linked file exists in the map (link-code would have refused otherwise)"
      },
      {
        "id": "e51ae4c5-30da-4028-be0f-67cb6f7688b5",
        "text": "refs <pebble> shows the codeLinks you added"
      }
    ],
    "whenToUse": "Binding a pebble to every file that implements it — a feature usually spans several. Find them via the graph first."
  },
  "createdAt": "2026-07-21T14:32:38.760Z",
  "description": "Bind a pebble to its implementation files",
  "id": "19c775a9-0850-440a-98ec-63f8bac0ca92",
