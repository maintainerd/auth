{
  "content": {
    "arguments": "$ARGUMENTS",
    "constraints": [
      {
        "id": "6346812b-f806-46a3-a2d9-02b7ec3c8700",
        "text": "Use the Bash tool. The Pebbles CLI at \"{PEBBLES_CLI}\" is the ONLY sanctioned way to change spec files — never edit .pebble files directly."
      },
      {
        "id": "5266b8d2-b098-45ac-8610-58a3a3dd8ffa",
        "text": "Bound by system rule: Spec mutation contract (rules/system/spec-mutation-contract)"
      },
      {
        "id": "7c9c019c-96fe-41f2-8f15-8fc0852bafd8",
        "text": "Bound by system rule: Findings are the append-only evidence log (rules/system/findings-as-evidence)"
      },
      {
        "id": "6f69aeb3-43e4-4231-abb5-a977d384117c",
        "text": "Bound by system rule: Analysis standard (rules/system/analysis-standard)"
      }
    ],
    "examples": [],
    "kind": "skill",
    "onFailure": [
      {
        "id": "1e15c7a2-e2db-4cda-8b08-91a5eac112d5",
        "text": "Read the CLI error — it names the fix; correct the call and retry once"
      },
      {
        "id": "b8f872cb-f9bf-4db9-b713-15081e8a437e",
        "text": "NEVER fall back to editing .pebble files directly, whatever failed"
      },
      {
        "id": "7468c905-671b-4fab-ac69-ffb4d90e6801",
        "text": "If still blocked, report the exact command and error to the user and stop"
      }
    ],
    "output": "A digest grouped by category, newest first, each finding with its linked pebble; stale verdicts flagged.",
    "prerequisites": [
      {
        "id": "0693aed1-34eb-45d8-9068-ac742841879f",
        "text": "Findings exist to digest — query --section findings first"
      }
    ],
    "purpose": "Digest the dated findings: what changed lately",
    "steps": [
      {
        "id": "24736c80-ac14-4a7f-963c-6050f1ae1c8c",
        "text": "Digest the findings log — what changed lately: $ARGUMENTS"
      },
      {
        "id": "4b2772e1-5cf9-4806-a1e1-25e758127909",
        "text": "STEP 1 — GATHER: \"{PEBBLES_CLI}\" query --section findings; read the recent ones by createdAt."
      },
      {
        "id": "b625b796-bede-41f6-921f-03bd56462ad9",
        "text": "STEP 2 — FOLLOW SUPERSEDES CHAINS: only chain TIPS are current truth — a superseded finding is history, not a live claim. Flag open chain-tips older than the latest map as UNCONFIRMED."
      },
      {
        "id": "4a6253b6-1c54-4b30-8941-bb425537c11e",
        "text": "STEP 3 — GROUP by category, newest first: verified-working / bugs / fixes / tech-debt / decisions — each with its linked pebble."
      },
      {
        "id": "20449abc-b29f-4cd5-8657-c2c9ceac1d9f",
        "text": "Do NOT create findings from this digest (it is a READ of the log). Report the grouped digest with unconfirmed items flagged."
      }
    ],
    "verify": [
      {
        "id": "eabf676e-a251-49c6-b2a4-e69004052e0e",
        "text": "Only supersedes-chain TIPS are presented as current truth; stale open tips flagged UNCONFIRMED"
      },
      {
        "id": "32152445-f4a0-4cbe-afab-4938b992c848",
        "text": "No findings were created — this is a read of the log"
      }
    ],
    "whenToUse": "Catching up on the findings log: what was verified, what broke, what was fixed lately."
  },
