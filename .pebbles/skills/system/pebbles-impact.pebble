{
  "content": {
    "arguments": "$ARGUMENTS",
    "constraints": [
      {
        "id": "e07d6592-7fab-49ee-941f-e659225add0f",
        "text": "Use the Bash tool. The Pebbles CLI at \"{PEBBLES_CLI}\" is the ONLY sanctioned way to change spec files — never edit .pebble files directly."
      },
      {
        "id": "749c3757-2710-4518-9980-37fe92cdff0d",
        "text": "Bound by system rule: Spec mutation contract (rules/system/spec-mutation-contract)"
      },
      {
        "id": "3d5428d2-35a8-46a8-ba3a-b522b6cda7d9",
        "text": "Bound by system rule: Reference integrity (rules/system/reference-integrity)"
      },
      {
        "id": "1fa40796-eaea-4805-b852-8724a3aa17d3",
        "text": "Bound by system rule: Graph-first navigation (rules/system/graph-first-navigation)"
      },
      {
        "id": "d6e44e27-68be-42d3-90e6-0f82dd086b1f",
        "text": "Bound by system rule: Analysis standard (rules/system/analysis-standard)"
      }
    ],
    "examples": [],
    "kind": "skill",
    "onFailure": [
      {
        "id": "6a409365-991c-4836-98b8-6d04de54e8a1",
        "text": "Read the CLI error — it names the fix; correct the call and retry once"
      },
      {
        "id": "e7ca23aa-0af3-4d41-b6f1-8bbdb0b75eff",
        "text": "NEVER fall back to editing .pebble files directly, whatever failed"
      },
      {
        "id": "6e087ef8-4ace-482e-8a9d-b839426af462",
        "text": "If still blocked, report the exact command and error to the user and stop"
      }
    ],
    "output": "What needs review or breaks, ranked by importedBy — nothing is changed.",
    "prerequisites": [
      {
        "id": "046fbfb4-d621-4f01-aee5-c5f09f383f73",
        "text": "A saved map — code-side blast radius reads it"
      }
    ],
    "purpose": "Blast radius of a change (spec + code dependents)",
    "steps": [
      {
        "id": "ac80aa35-2b45-4602-85f4-cf40b8f2f83b",
        "text": "Impact analysis — the blast radius BEFORE a change: $ARGUMENTS"
      },
      {
        "id": "2818b82e-7047-470f-8346-78717ec50558",
        "text": "SCOPE FIRST (echo): the pebble/unit that would change, and what the change is."
      },
      {
        "id": "a5b423f8-c1e0-4773-afe7-d6b0a3822795",
        "text": "STEP 1 — SPEC SIDE: the pebble's refs and every pebble referencing it (query/get) — who depends on this promise."
      },
      {
        "id": "dff872e2-31bc-44d4-ac04-497afc055fd5",
        "text": "STEP 2 — CODE SIDE: map-file and map-neighbors --in on its codeLinks — who IMPORTS it — and map-callers — who CALLS it. Rank by importedBy."
      },
      {
        "id": "37076f3b-843e-42da-ad9f-778e49ac820d",
        "text": "STEP 3 — Change NOTHING (code or spec); record the conclusion: \"{PEBBLES_CLI}\" add-finding <pebble> --title \"Impact: ...\" --category research --observation \"...\" --evidence \"...\"."
      },
      {
        "id": "643cc1ed-ecbe-43a6-affd-78a5415fca8c",
        "text": "Report: what breaks or needs review if this changes, ranked by blast radius."
      }
    ],
    "verify": [
      {
        "id": "da415429-1440-4281-a8ff-b9db84bd4a8f",
        "text": "The blast-radius conclusion is recorded as a finding (--category research or measurement)"
      }
    ],
    "whenToUse": "Before a risky change: the blast radius across spec dependents and code importers/callers."
  },
  "createdAt": "2026-07-21T14:32:38.768Z",
  "description": "Blast radius of a change (spec + code dependents)",
