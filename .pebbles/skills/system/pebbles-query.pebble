{
  "content": {
    "arguments": "$ARGUMENTS",
    "constraints": [
      {
        "id": "ff2d42b4-c14c-411e-9563-d857aad7b498",
        "text": "Use the Bash tool. The Pebbles CLI at \"{PEBBLES_CLI}\" is the ONLY sanctioned way to change spec files — never edit .pebble files directly."
      },
      {
        "id": "c70fa6c3-58dd-4d1a-97ec-3e7e0e78f246",
        "text": "Bound by system rule: Spec mutation contract (rules/system/spec-mutation-contract)"
      },
      {
        "id": "9520b72e-1cb3-40cd-a7e9-fed213a39e18",
        "text": "Bound by system rule: Status discipline (rules/system/status-discipline)"
      }
    ],
    "examples": [],
    "kind": "skill",
    "onFailure": [
      {
        "id": "fc2e9a57-f8d3-44c2-a618-16925990cf0c",
        "text": "Read the CLI error — it names the fix; correct the call and retry once"
      },
      {
        "id": "cb864fc2-e487-432f-a0f8-e346739c43a8",
        "text": "NEVER fall back to editing .pebble files directly, whatever failed"
      },
      {
        "id": "172a59f9-1189-4309-ade0-5476c834ea28",
        "text": "If still blocked, report the exact command and error to the user and stop"
      }
    ],
    "output": "Matching pebbles with paths and statuses; with --unit-status, the matching units ride along in each row.",
    "prerequisites": [],
    "purpose": "Find pebbles by status/type/text",
    "steps": [
      {
        "id": "f142cbaa-7916-4346-acac-0c1eafc13bd4",
        "text": "Run: \"{PEBBLES_CLI}\" query $ARGUMENTS"
      },
      {
        "id": "305a4cfd-c365-4e70-bf71-8dd6206f168e",
        "text": "(Flags: --section S --status X --unit-status X --type T --text SUBSTR; --unit-status matches checklist items / table fields / workflow nodes and returns them.) Report the matches with paths and statuses."
      }
    ],
    "verify": [],
    "whenToUse": "Finding pebbles by state or content: what's still planned, what's broken, everything mentioning webhooks. Combine --section/--status/--unit-status/--type/--text."
  },
