{
  "content": {
    "arguments": "$ARGUMENTS",
    "constraints": [
      {
        "id": "0b760272-e5b4-40a2-a604-3110c55fe7b5",
        "text": "Use the Bash tool. The Pebbles CLI at \"{PEBBLES_CLI}\" is the ONLY sanctioned way to change spec files — never edit .pebble files directly."
      },
      {
        "id": "a210b303-9c8b-49d4-b947-1dd381378477",
        "text": "Bound by system rule: Spec mutation contract (rules/system/spec-mutation-contract)"
      },
      {
        "id": "ace36cf2-c6b6-4c77-ad60-920196f2e17b",
        "text": "Bound by system rule: Table completeness (rules/system/table-completeness)"
      },
      {
        "id": "a660b735-e24e-4182-a0ba-e3abc668a2ea",
        "text": "Bound by system rule: Reference integrity (rules/system/reference-integrity)"
      }
    ],
    "examples": [],
    "kind": "skill",
    "onFailure": [
      {
        "id": "a1ab98c3-82ee-4eda-ae99-01bbaccd8b95",
        "text": "Read the CLI error — it names the fix; correct the call and retry once"
      },
      {
        "id": "061b762b-6fee-435e-9f7a-6d755374aa5c",
        "text": "NEVER fall back to editing .pebble files directly, whatever failed"
      },
      {
        "id": "45429238-2145-4c54-8b11-0b85b222205a",
        "text": "If still blocked, report the exact command and error to the user and stop"
      }
    ],
    "output": "The updated path, with droppedRefs reporting any links that didn't resolve.",
    "prerequisites": [
      {
        "id": "c937d58d-a932-41d2-b206-45a7206f06b6",
        "text": "The target is read with get FIRST — content is replaced whole, so patch from reality"
      }
    ],
    "purpose": "Update a pebble via a validated patch",
    "steps": [
      {
        "id": "075a89a5-df7a-467e-b18c-edf8bb37768c",
        "text": "Update a pebble through a validated patch: $ARGUMENTS"
      },
      {
        "id": "c1851ff1-7764-453a-9ad7-fd21f1180235",
        "text": "STEP 1 — GET FIRST: read the target with \"{PEBBLES_CLI}\" get <path> so you patch from reality, not memory. content is replaced WHOLE — send the full content object, never a fragment; id/version/createdAt are immutable."
      },
      {
        "id": "3ebd8760-892a-4bfa-a6f2-769ee6ef9c84",
        "text": "STEP 2 — PRESERVE UNIT STATE: units matched by id (or name when the patch omits id) keep their existing id/status/description when you omit them — but set what you actually know; never blank a field by forgetting it."
      },
      {
        "id": "c6962b6a-5dbd-4bfe-abd3-ce12a969ce7a",
        "text": "STEP 3 — PATCH: \"{PEBBLES_CLI}\" update <path> --patch '{...}'; wire FKs via refKey when targets exist."
      },
      {
        "id": "f67a93ca-73bd-4c51-81fa-9d280a26b398",
        "text": "Report: what changed, plus any droppedRefs (unresolved links) with why; `get` it back if unsure the content matches intent."
      }
    ],
    "verify": [
      {
        "id": "38ff1870-74a0-4da6-aaa2-53999d7c3fc2",
        "text": "get the pebble back and confirm the content matches what you intended"
      },
      {
        "id": "f850e741-8ae2-4bf7-9f4d-313c2db58f73",
        "text": "droppedRefs is empty — or every drop is reported to the user with why"
      }
    ],
    "whenToUse": "Changing existing spec through a validated patch. content is replaced whole — send the full object; unit ids/statuses/descriptions survive when omitted."
  },
  "createdAt": "2026-07-21T14:32:38.742Z",
  "description": "Update a pebble via a validated patch",
  "id": "6a51e959-6f2e-489d-8162-3ff9680b9ad4",
