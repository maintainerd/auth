{
  "content": {
    "constraints": [
      {
        "id": "f2a31f77-c3f8-4375-9526-b7fe7fcd0265",
        "text": "Use the Bash tool. The Pebbles CLI at \"{PEBBLES_CLI}\" is the ONLY sanctioned way to change spec files — never edit .pebble files directly."
      },
      {
        "id": "fe7c5089-cd4e-4080-8cba-fe0eb66f5efa",
        "text": "Bound by system rule: Spec mutation contract (rules/system/spec-mutation-contract)"
      }
    ],
    "examples": [],
    "kind": "skill",
    "onFailure": [
      {
        "id": "3fa21403-ba18-4fd5-b824-797496fd275b",
        "text": "Read the CLI error — it names the fix; correct the call and retry once"
      },
      {
        "id": "919cd287-91ef-404a-8a0a-ee8cd89bc80c",
        "text": "NEVER fall back to editing .pebble files directly, whatever failed"
      },
      {
        "id": "6b4b0fb8-8f90-4f8f-9e5b-2787b8e3a005",
        "text": "If still blocked, report the exact command and error to the user and stop"
      }
    ],
    "output": "The section keys with a one-line description each.",
    "prerequisites": [],
    "purpose": "List the spec-graph sections",
    "steps": [
      {
        "id": "643370f1-099d-44fb-83f6-20a09409757f",
        "text": "Run: \"{PEBBLES_CLI}\" sections and list them with one line on what each holds."
      }
    ],
    "verify": [],
    "whenToUse": "First contact with a project — what sections exist and what each holds."
  },
