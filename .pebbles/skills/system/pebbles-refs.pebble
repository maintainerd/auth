        "id": "2ba2b66f-6cc8-4353-86ad-1d27425aa517",
        "text": "Use the Bash tool. The Pebbles CLI at \"{PEBBLES_CLI}\" is the ONLY sanctioned way to change spec files — never edit .pebble files directly."
      },
      {
        "id": "0e4f9b08-90fd-4b96-ab07-fd256808f3c6",
        "text": "Bound by system rule: Spec mutation contract (rules/system/spec-mutation-contract)"
      },
      {
        "id": "cf384f8d-8815-4a2b-86f7-16662413441e",
        "text": "Bound by system rule: Reference integrity (rules/system/reference-integrity)"
      }
    ],
    "examples": [],
    "kind": "skill",
    "onFailure": [
      {
        "id": "abb7fb30-7454-491f-9ad8-dd69c582f927",
        "text": "Read the CLI error — it names the fix; correct the call and retry once"
      },
      {
        "id": "770614ed-c198-4e5e-a19f-9f85ecd60333",
        "text": "NEVER fall back to editing .pebble files directly, whatever failed"
      },
      {
        "id": "9b7259be-4a49-414b-93b1-4d5232609a15",
        "text": "If still blocked, report the exact command and error to the user and stop"
      }
    ],
    "output": "Outgoing refs + codeLinks and every pebble/unit referencing the target, both directions.",
    "prerequisites": [],
    "purpose": "A pebble's connections both ways (refs, codeLinks, backlinks)",
    "steps": [
      {
        "id": "2b8bd451-6fe9-43e6-a057-da1c9ade7cc0",
        "text": "Run: \"{PEBBLES_CLI}\" refs $ARGUMENTS"
      },
      {
        "id": "997bf831-be98-4c15-9185-9b52010b7d69",
        "text": "(Argument: a pebble path.) Report its outgoing refs + codeLinks AND every pebble/unit that references it. If deeper code analysis is wanted, each codeLink path is a map node id — `map-file <path>` gives its symbols/imports/callers instantly."
      }
    ],
    "verify": [],
    "whenToUse": "Before changing anything shared: who references this pebble, and what does it point at (refs, codeLinks, backlinks)?"
  },
