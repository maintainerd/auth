{
  "content": {
    "arguments": "$ARGUMENTS",
    "constraints": [
      {
        "id": "53d0e35f-520e-40fa-a56e-794ea05a7fc8",
        "text": "Use the Bash tool. The Pebbles CLI at \"{PEBBLES_CLI}\" is the ONLY sanctioned way to change spec files — never edit .pebble files directly."
      },
      {
        "id": "6d51e398-dc52-4e54-adef-28a173466b15",
        "text": "Bound by system rule: Spec mutation contract (rules/system/spec-mutation-contract)"
      },
      {
        "id": "5fef1b60-275e-4b8d-b363-a44b3e00af19",
        "text": "Bound by system rule: Status discipline (rules/system/status-discipline)"
      }
    ],
    "examples": [],
    "kind": "skill",
    "onFailure": [
      {
        "id": "f653ac2e-8720-4626-8bf4-dde1275fdaad",
        "text": "Read the CLI error — it names the fix; correct the call and retry once"
      },
      {
        "id": "2cf955c9-6ad0-45b9-af90-015a8e172368",
        "text": "NEVER fall back to editing .pebble files directly, whatever failed"
      },
      {
        "id": "7aff37c9-27a7-4df7-bac4-83a877ee24a9",
        "text": "If still blocked, report the exact command and error to the user and stop"
      }
    ],
    "output": "The checklist with the new item.",
    "prerequisites": [],
    "purpose": "Append an item to a checklist pebble",
    "steps": [
      {
        "id": "48bd89e6-f61d-4049-bb5c-4b4c08b5821a",
        "text": "Run: \"{PEBBLES_CLI}\" add-item <path> --text \"...\" [--status S] based on: $ARGUMENTS"
      }
    ],
    "verify": [],
    "whenToUse": "Appending one entry to a checklist pebble (requirement AC, test case…)."
  },
