{
  "content": {
    "arguments": "$ARGUMENTS",
    "constraints": [
      {
        "id": "6af9b7cd-acda-4c49-af10-0f18b23a3729",
        "text": "Use the Bash tool. The Pebbles CLI at \"{PEBBLES_CLI}\" is the ONLY sanctioned way to change spec files — never edit .pebble files directly."
      },
      {
        "id": "8dd8ac74-7fb3-4dea-bf4c-dc4fdf5d0070",
        "text": "Bound by system rule: Spec mutation contract (rules/system/spec-mutation-contract)"
      },
      {
        "id": "cad26358-e668-48f9-9514-872492fad9e6",
        "text": "Bound by system rule: Status discipline (rules/system/status-discipline)"
      }
    ],
    "examples": [],
    "kind": "skill",
    "onFailure": [
      {
        "id": "8a89e427-35d9-41bd-9db7-7346d2da0706",
        "text": "Read the CLI error — it names the fix; correct the call and retry once"
      },
      {
        "id": "dcab1c03-eb7c-4417-aa3c-3e266e8ba55c",
        "text": "NEVER fall back to editing .pebble files directly, whatever failed"
      },
      {
        "id": "9d4e3a3a-97ad-4931-a3b1-66e9d6efbdf1",
        "text": "If still blocked, report the exact command and error to the user and stop"
      }
    ],
    "output": "The pebble/unit with its new, truthful status.",
    "prerequisites": [],
    "purpose": "Set a pebble's (or unit's) status",
    "steps": [
      {
        "id": "207d1386-6fc1-45d5-9734-a720a21bd1a6",
        "text": "Run: \"{PEBBLES_CLI}\" set-status <path> <status> [--unit <id>] based on: $ARGUMENTS"
      },
      {
        "id": "50c8749a-6d9c-4784-abef-a5ce240682ae",
        "text": "Only set a status you have verified against the actual code."
      }
    ],
    "verify": [
      {
        "id": "ae8a2ba2-0aa9-4fbd-9372-b43872d84c73",
        "text": "The status you set is one you VERIFIED against code/behavior, not assumed"
      }
    ],
    "whenToUse": "Recording verified progress or regressions — at the pebble or a single unit (--unit). Only after checking the actual code."
  },
