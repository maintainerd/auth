    "arguments": "$ARGUMENTS",
    "constraints": [
      {
        "id": "2fefe81d-6123-489c-9f0b-816785c32ad1",
        "text": "Use the Bash tool. The Pebbles CLI at \"{PEBBLES_CLI}\" is the ONLY sanctioned way to change spec files — never edit .pebble files directly."
      },
      {
        "id": "b97df6e4-c050-4825-b065-ac2ab613ccb2",
        "text": "Bound by system rule: Spec mutation contract (rules/system/spec-mutation-contract)"
      },
      {
        "id": "4a248727-d25c-4e0a-877b-57f4cf1e4c33",
        "text": "Bound by system rule: Graph-first navigation (rules/system/graph-first-navigation)"
      }
    ],
    "examples": [],
    "kind": "skill",
    "onFailure": [
      {
        "id": "640287b4-61d1-4f5a-9ede-7f4cb46c40b4",
        "text": "Read the CLI error — it names the fix; correct the call and retry once"
      },
      {
        "id": "18da9dc5-46ed-47f4-82a7-67e334e13ecb",
        "text": "NEVER fall back to editing .pebble files directly, whatever failed"
      },
      {
        "id": "2c75e33c-cce3-44f8-871d-4686f9a16703",
        "text": "If still blocked, report the exact command and error to the user and stop"
      }
    ],
    "output": "A saved dependency graph (files, languages, import/call edges, hubs) plus a printed summary; all map-* queries read it.",
    "prerequisites": [],
    "purpose": "Map the project's files (honors .pebblesignore)",
    "steps": [
      {
        "id": "42653359-ba98-485c-9b82-2c7e828bf0ce",
        "text": "Run: \"{PEBBLES_CLI}\" map"
      },
      {
        "id": "5770f1f1-a563-4f26-aa81-17f95e543868",
        "text": "Summarize the layout for the user: main directories, dominant languages, notable files. Mention if the output says truncated. $ARGUMENTS"
      }
    ],
    "verify": [],
    "whenToUse": "Before any code navigation, extraction, or audit — and again (--fresh) whenever the code changed since the last run. The map is the prerequisite for every map-* query."
  },
