# Git
.git
.gitignore

# Documentation
README.md
*.md
doc/

# Development files
.env.example
docker-compose.yml
Dockerfile
Dockerfile.local

# Build artifacts
tmp/
*.log

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Dependencies (will be downloaded in container)
vendor/

# NOTE: generated protobuf code lives in internal/platform/gen/ and MUST be
# included — the build depends on it, so it is intentionally not ignored here.

# Test files
*_test.go
test/

# Scripts (not needed in container)
scripts/

# Nginx config (not needed in app container)
nginx/

# Frontend deps / build output / secrets — rebuilt inside the image, never
# copied from the host (would bloat context and leak local env).
**/node_modules/
**/dist/
**/.env
web/**/coverage/
